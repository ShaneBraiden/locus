# Server-side environment variables, read by server/ (root .env, then
# server/.env overrides). Everything is OPTIONAL in dev: without a Gemini key
# the server uses deterministic replies, and guest tokens are accepted.
#
# Client-side (Vite) variables live in client/.env.example instead.

# GEMINI_API_KEY: turns the assessment into an actual conversation — FAB asks
# in its own words and reads free-text answers. Without it the same 28 items
# are served as plain multiple choice. Scoring is identical either way: Gemini
# only picks which pre-scored option an answer meant, it never scores or ranks.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: model used for narration (default: gemini-3.5-flash)
# GEMINI_MODEL="gemini-3.5-flash"

# GEMINI_LIVE_MODEL: the Live API model used as FAB's ear (speech to text). It
# hears Tamil and the other Indic languages natively and transcribes them
# verbatim, which is markedly better than the REST STT for Indic speech. Needs
# no extra key — it reuses GEMINI_API_KEY.
# Note this model only answers in audio, so its spoken reply is discarded; FAB's
# words always come from the flow, and Sarvam speaks them.
# GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"

# GEMINI_LIVE_STT: set to "off" to skip Gemini Live and use Sarvam for speech
# to text instead. Live is used by default whenever GEMINI_API_KEY is set.
# GEMINI_LIVE_STT="off"

# SARVAM_API_KEY: adds voice chat. The student can tap the mic and talk, and
# FAB answers out loud in English or ten Indic languages. A spoken turn runs
# through the exact same conversation a typed one does — Sarvam only converts
# between audio and text, it never picks an option or scores anything. Without
# this key the mic button is hidden and typing works exactly as before.
SARVAM_API_KEY="MY_SARVAM_API_KEY"

# SARVAM_SPEAKER: FAB's voice (default: anushka). Other bulbul:v2 voices are
# abhilash, manisha, vidya, arya, karun, hitesh.
# SARVAM_SPEAKER="anushka"

# SARVAM_STT_MODEL / SARVAM_TTS_MODEL / SARVAM_TRANSLATE_MODEL: defaults are
# saarika:v2.5, bulbul:v2 and sarvam-translate:v1. bulbul:v3 unlocks 30+ voices
# but drops pitch and loudness control.
# SARVAM_STT_MODEL="saarika:v2.5"
# SARVAM_TTS_MODEL="bulbul:v2"
# SARVAM_TRANSLATE_MODEL="sarvam-translate:v1"

# PORT: API port (default 3000; keep in sync with client/vite.config.ts proxy)
# PORT=3000

# MONGODB_URI: where users and per-user app state are stored.
# Defaults to mongodb://127.0.0.1:27017/northr when unset. If MongoDB is
# unreachable the server falls back to in-memory storage (dev only — accounts
# and saved state are lost on restart, and it warns loudly at boot).
MONGODB_URI="mongodb://127.0.0.1:27017/northr"

# JWT_SECRET: signs auth tokens. Must be set (>=16 chars) in production;
# a dev default is used otherwise. Changing it logs everyone out.
JWT_SECRET="change-me-to-a-long-random-string"

# ALLOW_GUEST: permits the literal "local_guest_token" for guest sessions.
# Enabled automatically outside production; set "true" to force it on.
# ALLOW_GUEST=true

# APP_URL: The URL where the app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
